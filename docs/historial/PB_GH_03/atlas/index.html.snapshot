        <button type="button" class="view-btn" data-view="genomica"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 4c4 0 4 16 8 16s4-16 8-16"/><path d="M4 20c4 0 4-16 8-16s4 16 8 16"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="16" x2="17" y2="16"/></svg></span> Paleogenómica</button>
        <button type="button" class="view-btn" data-view="primatologia"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14c-2 0-4-2-4-5 0-3 2-5 5-5 2 0 3 1 4 3 1-2 2-3 4-3 3 0 5 2 5 5 0 3-2 5-4 5"/><path d="M8 14c0 4 2 6 4 6s4-2 4-6"/><path d="M9 9h.01M15 9h.01"/></svg></span> Primatología</button>
        <button type="button" class="view-btn" data-view="coexistencias"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16M15 4v16"/><circle cx="6" cy="14" r="1.5"/><circle cx="12" cy="14" r="1.5"/><circle cx="18" cy="14" r="1.5"/></svg></span> Coexistencias</button>
        <button type="button" class="view-btn" data-view="datacion"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/><path d="M5 4l-2 2M19 4l2 2"/></svg></span> Datación</button>
        <button type="button" class="view-btn" data-view="debates"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span> Debate</button>
        <button type="button" class="view-btn" data-view="socratico"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></span> Socrático</button>
        <button type="button" class="view-btn" data-view="estratigrafia"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/><path d="M7 6v12M17 6v12"/></svg></span> Estratigrafía</button>
        <button type="button" class="view-btn" data-view="tafonomia"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M2 12h4M18 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg></span> Tafonomía</button>
        <button type="button" class="view-btn" data-view="introgresion"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M16 3h5v5M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg></span> Introgresión</button>
        <!-- SEPARADOR -->
        <span class="nav-sep" aria-hidden="true"></span>
        <!-- GRUPO 4: RECURSOS DIDÁCTICOS -->
        <span class="nav-group-label">Didáctico</span>
        <button type="button" class="view-btn" data-view="aula"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h10a4 4 0 0 1 4 4v10H8a4 4 0 0 1-4-4V5z"/><path d="M8 9h6M8 13h8"/><path d="M18 9h2v10"/></svg></span> Centro docente</button>
        <button type="button" class="view-btn" data-view="recursos"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"/><path d="M8 7h8M8 11h6"/></svg></span> Recursos</button>
        <button type="button" class="view-btn" data-view="holotipos"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5L5 19"/></svg></span> Holotipos</button>
        <button type="button" class="paleolab-nav-btn" data-paleolab-open data-action="openPaleoLab" aria-haspopup="dialog" aria-controls="splDialog"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.3L4.5 19a2 2 0 0 0 1.74 3h11.52a2 2 0 0 0 1.74-3L14 9.3V2"/><path d="M8.5 2h7M6.5 17h11"/></svg></span> PaleoLab 50</button>
        <button type="button" class="view-btn" data-view="itinerarios"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="5" cy="5" r="2"/><circle cx="19" cy="19" r="2"/><path d="M5 7v7a4 4 0 0 0 4 4h6"/><path d="M14 15l5 4-5 4"/></svg></span> Itinerarios did&aacute;cticos</button>
        <button type="button" class="view-btn" data-view="dispersal"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="5" cy="17" r="2"/><circle cx="12" cy="11" r="2"/><circle cx="19" cy="6" r="2"/><path d="M7 16l3.5-3.5M14 10l3.5-2.8"/><path d="M4 21c5-1 10-4 16-13"/></svg></span> Simulador</button>
        <button type="button" class="view-btn" data-view="constructor"><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><path d="M8.5 8.2l2.2 6.5M15.5 8.2l-2.2 6.5"/></svg></span> Constructor</button>
      </div>
      <div class="search-box">
        <span class="ico" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
        <input type="text" id="searchInput" data-search-input placeholder="Buscar especie, holotipo, yacimiento… (pulsa /)" aria-label="Buscar en el atlas">
        <kbd class="search-kbd" title="Pulsa / para buscar" aria-hidden="true">/</kbd>
      </div>
      <button type="button" class="class-mode-btn" data-action="activateClassMode" aria-label="Activar modo clase">Modo clase</button>
      <button type="button" class="filter-reset-btn" data-action="resetGlobalFilters" title="Restablecer búsqueda, clado y rango temporal">Limpiar filtros</button>
      <div class="controls">
        <select id="nivelEducativo" aria-label="Nivel de complejidad del atlas" data-level-select>
          <option value="doctorado">Nivel Doctorado</option>
          <option value="universitario" selected>Nivel Universitario</option>
          <option value="basico">Nivel Básico</option>
        </select>
      <p class="level-hint" style="font-size:0.72rem;color:var(--text-hint);font-family:var(--font-mono);margin-top:4px;line-height:1.4">Si es tu primera vez, empieza en <strong>Nivel Básico</strong>.</p>
      </div>
    </div>
    <div class="toolbar-row toolbar-row-orientation">
      <div class="view-orientation" id="viewOrientation" aria-live="polite">
        <div class="view-orientation-tier" id="viewOrientationTier">Vista troncal</div>
        <div class="view-orientation-body">
          <div class="view-orientation-title-row">
            <h2 id="viewOrientationTitle">Cronolog&iacute;a</h2>
            <span class="view-orientation-family" id="viewOrientationFamily">Explorar</span>
          </div>
          <p class="view-orientation-copy" id="viewOrientationCopy">Ordena los taxones en el tiempo para reconocer apariciones, solapamientos y desapariciones antes de entrar en debates m&aacute;s especializados.</p>
        </div>
        <div class="view-orientation-meta">
          <span class="view-orientation-chip" id="viewOrientationAudience">Adecuada para p&uacute;blico general y docencia</span>
          <span class="view-orientation-chip view-orientation-chip-muted" id="viewOrientationGoal">Pregunta principal: qu&eacute; aparece primero y qu&eacute; convive</span>
        </div>
      </div>
    </div>
    <div class="toolbar-row toolbar-row-filters">
      <span class="filter-label"><span class="ico" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg></span> Clado:</span>
      <div class="filter-bar">
        <button type="button" class="filter-chip active" data-f="all" data-clade-filter="all" aria-pressed="true">Todos</button>
        <button type="button" class="filter-chip" data-f="basal" data-clade-filter="basal">⬤ Basales / Mioceno</button>
        <button type="button" class="filter-chip" data-f="australo" data-clade-filter="australo">⬤ Australopithecus</button>
        <button type="button" class="filter-chip" data-f="paran" data-clade-filter="paran">⬤ Paranthropus</button>
        <button type="button" class="filter-chip" data-f="homo" data-clade-filter="homo">⬤ Homo</button>
      </div>
      <span id="countLabel"></span>
    </div>
    <div class="time-filter-panel" aria-label="Filtro temporal global">
      <div>
        <div class="time-filter-title">
          <span class="ico" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
          Filtro temporal global
        </div>
        <div class="time-slider-wrap">
          <div class="time-slider-track"><div class="time-slider-fill" id="timeSliderFill"></div></div>
          <input class="time-range-input" id="timeRangeOld" type="range" min="0" max="23" step="0.01" value="23"
                 aria-label="Límite más antiguo del filtro temporal (en millones de años)"
                 aria-valuemin="0" aria-valuemax="23"
                 aria-valuenow="23" aria-valuetext="23 Ma"
                 data-time-bound="old">
          <input class="time-range-input" id="timeRangeYoung" type="range" min="0" max="23" step="0.01" value="0"
                 aria-label="Límite más reciente del filtro temporal (en millones de años)"
                 aria-valuemin="0" aria-valuemax="23"
                 aria-valuenow="0" aria-valuetext="0 Ma"
                 data-time-bound="young">
        </div>
      </div>
      <div class="time-filter-actions">
        <div class="time-filter-readout" id="timeFilterReadout">0–23 Ma</div>
        <button type="button" class="time-chip-btn" data-time-preset="2,2">Hace 2 Ma · Pleistoceno</button>
        <button type="button" class="time-chip-btn" data-time-preset="0.3,0.3">Hace 300.000 años</button>
        <button type="button" class="time-chip-btn" data-time-preset="23,0">Todo</button>
      </div>
    </div>
    <div id="activeFilterSummary" class="active-filter-summary is-complete" aria-live="polite">
      <strong>Filtros</strong>
      <span>Catálogo completo visible.</span>
    </div>
  </div>

  <!-- Destino del skip-link (FIX C-3b) — FIX S-1: elemento <main> nativo en lugar de div+role=main -->
  <main id="main-content" aria-label="Contenido principal del atlas">
  <h1 class="sr-only">PaleoBot — Atlas Paleoantropológico Interactivo</h1>
  <div id="view-timeline" class="view-section active">
    <!-- Tarjeta de tarea de aula v58 -->
    <details class="classroom-task-card" style="margin-bottom:14px;background:linear-gradient(135deg,#f0faf5,#e8f4f0);border:1px solid rgba(14,127,101,0.22);border-radius:12px;padding:14px 16px;">
      <summary style="cursor:pointer;font-weight:700;color:var(--accent);font-size:0.88rem;list-style:none;display:flex;align-items:center;gap:8px;" aria-label="Tarea de aula opcional para la cronología">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Tarea de aula (opcional) — Antes de explorar las fichas
      </summary>
      <div style="margin-top:10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;">
        <div style="background:rgba(255,255,255,0.8);border-radius:8px;padding:11px;border:1px solid rgba(14,127,101,0.12);"><p style="margin:0 0 5px;font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#0a6b49;font-family:var(--font-mono);">Elige un momento temporal</p><p style="margin:0;font-size:0.85rem;color:var(--text-sec);line-height:1.55">Usa el filtro de tiempo para situarte en un período concreto (p.ej. hace 2 Ma). ¿Qué taxones esperas encontrar y en qué regiones?</p></div>
        <div style="background:rgba(255,255,255,0.8);border-radius:8px;padding:11px;border:1px solid rgba(14,127,101,0.12);"><p style="margin:0 0 5px;font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#0a6b49;font-family:var(--font-mono);">Compara 3 taxones</p><p style="margin:0;font-size:0.85rem;color:var(--text-sec);line-height:1.55">Elige 3 especies, compara un rasgo y formula una pregunta que las fichas no respondan por sí solas.</p></div>
        <div style="background:rgba(255,255,255,0.8);border-radius:8px;padding:11px;border:1px solid rgba(14,127,101,0.12);"><p style="margin:0 0 5px;font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#0a6b49;font-family:var(--font-mono);">Producto esperado</p><p style="margin:0;font-size:0.85rem;color:var(--text-sec);line-height:1.55">Un párrafo con: un dato observable, una inferencia razonada y una duda metodológica.</p></div>
      </div>
    </details>
    <aside class="evidence-legend-panel" role="note" aria-label="Clave de lectura de la evidencia fósil">
      <div class="evidence-legend-copy">
        <strong>Lee cada taxón con cautela metodológica</strong>
        La cronología no solo ordena especies: indica también cuánta evidencia sostiene cada interpretación.
      </div>
      <div class="evidence-legend-items" aria-label="Niveles de evidencia">
        <span class="evidence-badge evidence-high">Evidencia Alta</span>
        <span class="evidence-badge evidence-medium">Evidencia Media</span>
        <span class="evidence-badge evidence-low">Evidencia Baja</span>
        <span class="evidence-badge evidence-debated">Evidencia Debate</span>
        <span class="evidence-badge evidence-review">Evidencia Revisión</span>
      </div>
      <div class="evidence-legend-note">La etiqueta resume completitud fósil, estabilidad taxonómica y grado de consenso; no sustituye la lectura crítica de la ficha.</div>
    </aside>
    <div class="timeline-wrapper" id="timelineList"></div>
    <div id="timelineEmptyState" class="filter-empty-state" role="status" aria-live="polite">
      <div>
        <strong>No hay taxones visibles con esta combinación</strong>
        <p>La búsqueda, el clado o el rango temporal han dejado la cronología sin registros. Puedes ampliar el intervalo temporal o limpiar todos los filtros.</p>
      </div>
      <button type="button" class="filter-reset-btn" data-action="resetGlobalFilters">Limpiar filtros</button>
    </div>
  </div>

  <div id="view-tree" class="view-section">
    <aside class="evidence-legend-panel" aria-label="Clave de lectura de la evidencia fósil en el árbol">
      <div class="evidence-legend-copy">
        <strong>Árbol por clados con nivel de evidencia</strong>
        Compara grupos sin confundir abundancia de fósiles con certeza absoluta: algunos nodos siguen siendo hipótesis abiertas.
      </div>
      <div class="evidence-legend-items" aria-label="Niveles de evidencia">
        <span class="evidence-badge evidence-high">Evidencia Alta</span>
        <span class="evidence-badge evidence-medium">Evidencia Media</span>
        <span class="evidence-badge evidence-low">Evidencia Baja</span>
        <span class="evidence-badge evidence-debated">Evidencia Debate</span>
        <span class="evidence-badge evidence-review">Evidencia Revisión</span>
      </div>
      <div class="evidence-legend-note">Úsalo como guía de lectura antes de abrir las fichas detalladas o el cladograma ramificado.</div>
    </aside>
    <div class="tree-grid">
        <div class="clade-column basal"><div class="clade-header">Mioceno / Basales</div><div id="tree-basal"></div></div>
        <div class="clade-column australo"><div class="clade-header">Australopithecus</div><div id="tree-australo"></div></div>
        <div class="clade-column paran"><div class="clade-header">Paranthropus</div><div id="tree-paran"></div></div>
        <div class="clade-column homo"><div class="clade-header">Homo</div><div id="tree-homo"></div></div>
    </div>
    <div id="treeEmptyState" class="filter-empty-state" role="status" aria-live="polite">
      <div>
        <strong>El árbol simple no tiene nodos visibles</strong>
        <p>Los filtros actuales ocultan todos los taxones de este diagrama. Restablece la búsqueda para volver a ver los clados completos.</p>
      </div>
      <button type="button" class="filter-reset-btn" data-action="resetGlobalFilters">Limpiar filtros</button>
    </div>
  </div>

  <div id="view-phylo" class="view-section">
    <div class="phylo-outer">
      <div class="phylo-header">
        <div>
          <h2>Cladograma filogenético ramificado</h2>
          <p>Hipótesis didáctica con nodos ancestrales, ramas bifurcadas y eje temporal proporcional. Cada nodo resume la sinapomorfía o cambio evolutivo que define la divergencia.</p>
        </div>
        <div class="phylo-legend">
          <div class="phylo-legend-item"><span class="legend-swatch basal"></span>Basales</div>
          <div class="phylo-legend-item"><span class="legend-swatch australo"></span>Australopithecus</div>
          <div class="phylo-legend-item"><span class="legend-swatch paran"></span>Paranthropus</div>
          <div class="phylo-legend-item"><span class="legend-swatch homo"></span>Homo</div>
          <div class="phylo-legend-item"><span class="legend-swatch node"></span>Nodo clicable</div>
          <div class="phylo-legend-item"><span class="legend-swatch alt"></span>Hipótesis alternativa</div>
        </div>
      </div>
      <div class="phylo-summary-grid">
        <article class="phylo-summary-card">
          <strong>Eje temporal</strong>
          <p>Lee de izquierda a derecha desde 23 Ma hasta el presente. La posición horizontal de ramas y nodos es proporcional al tiempo.</p>
        </article>
        <article class="phylo-summary-card">
          <strong>Nodos</strong>
          <p>Haz clic en un nodo ancestral para ver la sinapomorfía o rasgo derivado que justifica la separación del clado.</p>
        </article>
        <article class="phylo-summary-card">
          <strong>Filtros</strong>
          <p>El deslizador temporal atenúa los taxones fuera de rango y conserva la estructura para no perder la hipótesis completa.</p>
        </article>
      </div>
      <div class="phylo-scroll">
        <div id="cladeNodeInfo" class="clado-node-info">
          <div>
            <code>Sinapomorfía</code>
            <h3>Selecciona un nodo</h3>
          </div>
          <p>Los nodos internos representan ancestros hipotéticos. Al pulsarlos verás el carácter derivado que se usa aquí para explicar la divergencia.</p>
        </div>
        <div id="phyloSvgContainer"></div>
      </div>
      <div class="phylo-footer">
        <span>Haz clic en una hoja terminal para abrir la ficha taxonómica.</span>
        <span>Cladograma sintético: orienta el razonamiento, no sustituye una matriz filogenética publicada.</span>
      </div>
    </div>
  </div>

  <div id="view-contexto" class="view-section">
    <div class="context-outer">
      <div class="context-header">
        <div>
          <h2>Línea de tiempo comparada Homo / contexto geológico</h2>
          <p>Superposición de rangos taxonómicos con eventos climáticos, vegetacionales y tectónicos para leer la evolución como respuesta adaptativa a cambios ambientales de larga duración.</p>
        </div>
        <div class="context-legend">
            <span class="context-legend-item"><span class="context-legend-swatch vegetation"></span> Vegetación / C4</span>
            <span class="context-legend-item"><span class="context-legend-swatch climate"></span> Clima</span>
            <span class="context-legend-item"><span class="context-legend-swatch tectonic"></span> Tectónica</span>
            <span class="context-legend-item"><span class="context-legend-swatch homo"></span> Taxones Homo</span>
        </div>
      </div>

      <div class="context-meta-grid">
        <div class="context-summary-grid">
          <article class="context-summary-card">
            <strong>Mioceno final</strong>
            <p>La tectónica del Rift y la expansión progresiva de ambientes más abiertos coinciden con los primeros homininos y con una locomoción todavía mixta entre árbol y suelo.</p>
          </article>
          <article class="context-summary-card">
            <strong>Plioceno</strong>
            <p>La expansión de plantas C4 y la estacionalidad creciente favorecen mosaicos ecológicos donde se diversifican australopitecos y robustos con estrategias tróficas distintas.</p>
          </article>
          <article class="context-summary-card">
            <strong>Pleistoceno</strong>
            <p>La intensificación glaciar, la variabilidad climática y la reorganización de hábitats acompañan la encefalización, la dispersión del género Homo y la plasticidad cultural.</p>
          </article>
        </div>
        <aside class="context-guide-card">
          <strong>Cómo leer esta vista</strong>
          <p>La banda superior reúne procesos ambientales de larga duración. Debajo aparecen los taxones filtrados para que se vea qué cambios ambientales coincidieron con cada tramo evolutivo.</p>
          <p><span id="contextVisibleCount">0</span> taxones visibles en el filtro actual · <span id="contextRangeHint">sin rango</span></p>
        </aside>
      </div>

      <div class="context-scroll">
        <svg id="contextSvg" class="context-svg" role="img" aria-label="Cronología comparada entre homininos y contexto geológico-climático"></svg>
      </div>

      <div class="context-footer">
        <span>Haz clic en una barra para abrir la ficha taxonómica.</span>
        <span>Las bandas superiores representan procesos de larga duración, no eventos puntuales.</span>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════════
       VISTA: CLIMA PAGES2K / NOAA / LR04
       Línea de tiempo climática comparada con rangos de homininos.
       Datos: LR04 δ¹⁸O (Lisiecki & Raymo 2005), EPICA Dome C
              (Jouzel et al. 2007), PAGES 2k (2013, 2019),
              Marine Isotope Stages (Lisiecki & Raymo 2005).
       ═══════════════════════════════════════════════════════════════════ -->
  <div id="view-clima" class="view-section">
    <div class="clima-outer">

      <!-- ── Cabecera ─────────────────────────────────────────────── -->
      <header class="clima-header">
        <div>
          <h2>🌡 Línea de tiempo climática comparada — PAGES2k / NOAA / LR04</h2>
          <p>Superposición de proxies paleoclimáticos actualizados (2019–2023): δ¹⁸O del stack CENOGRID
             (Westerhold et al. 2020 <em>Science</em>), temperatura PAGES 2k (Consortium 2019 <em>Nature Geoscience</em>),
             eventos D-O (Menviel et al. 2020 <em>Nature Reviews Earth & Environment</em>) y estadios isotópicos marinos (Railsback et al. 2015) sobre la tabla cronoestratigráfica ICS v2023/09,
             con los rangos cronológicos de los homininos. Permite leer la evolución humana como
             respuesta adaptativa a cambios climáticos documentados instrumentalmente y por proxies.</p>
        </div>
        <div class="clima-source-pills">
          <a class="clima-source-pill doi" href="https://doi.org/10.1126/science.aba6853" target="_blank" rel="noopener">
            📄 CENOGRID δ¹⁸O · Westerhold et al. 2020
          </a>
          <a class="clima-source-pill doi" href="https://doi.org/10.1038/s41561-019-0400-0" target="_blank" rel="noopener">
            📄 PAGES 2k · Consortium 2019
          </a>
          <a class="clima-source-pill doi" href="https://doi.org/10.1038/s43017-020-00106-y" target="_blank" rel="noopener">
            📄 Eventos D-O · Menviel et al. 2020
          </a>
          <a class="clima-source-pill doi" href="https://doi.org/10.1126/sciadv.abc8975" target="_blank" rel="noopener">
            📄 Homininos-Clima · Potts et al. 2020
          </a>
          <a class="clima-source-pill" href="https://stratigraphy.org/ICSchart/Cohen2013_Episodes.pdf" target="_blank" rel="noopener">
            📄 ICS Chart · Cohen et al. 2013 (act.)
          </a>
          <a class="clima-source-pill" href="https://www.ncei.noaa.gov/products/paleoclimatology" target="_blank" rel="noopener">
            🌐 NOAA NCEI Paleoclimatology
          </a>
        </div>
      </header>

      <!-- ── KPIs ─────────────────────────────────────────────────── -->
      <div class="clima-kpi-strip" id="climaKpiStrip" aria-live="polite" aria-atomic="false">
        <div class="clima-kpi">
          <strong>CENOGRID δ¹⁸O · 2020</strong>
          <span class="kpi-val">66 Ma de registro</span>
          <p>Stack CENOGRID (Westerhold et al. 2020 <em>Science</em>). Proxy astronómicamente datado de volumen de hielo y temperatura profunda oceánica.</p>
        </div>
        <div class="clima-kpi">
          <strong>Stack EPICA / NOAA 2022</strong>
          <span class="kpi-val">800 Ka hacia atrás</span>
          <p>Núcleo de hielo antártico (NOAA NCEI 2022) — temperatura relativa y CO₂ atmosférico. Base: Extier et al. 2018.</p>
        </div>
        <div class="clima-kpi">
          <strong>PAGES 2k 2019 — Era Común</strong>
          <span class="kpi-val">7 regiones · 692 proxies</span>
          <p>Consortium (2019) <em>Nature Geoscience</em>. Reconstrucción multidecadal CE 1–2000. Referencia: CE 1961–1990. Neukom et al. 2019 <em>Nature</em>.</p>
        </div>
        <div class="clima-kpi">
          <strong>Estadios Isotópicos (MIS)</strong>
          <span class="kpi-val" id="climaMisCount">103 MIS visibles</span>
          <p>Impares = interglaciares cálidos · Pares = glaciares fríos. Resolución variable por escala.</p>
        </div>
      </div>

      <!-- ── Controles de escala y capas ─────────────────────────── -->
      <div class="clima-scale-bar" role="group" aria-label="Controles de escala temporal y capas">
        <span class="clima-scale-label">⏱ Escala:</span>
        <button type="button" class="clima-scale-btn active" data-clima-scale="full"
