        <button type="button" class="landing-action" data-view="map">Investigar yacimientos</button>
        <button type="button" class="landing-action" data-view="recursos">Banco de recursos</button>
      </div>
      <div class="landing-evidence-strip" aria-label="Actualizaciones científicas destacadas">
