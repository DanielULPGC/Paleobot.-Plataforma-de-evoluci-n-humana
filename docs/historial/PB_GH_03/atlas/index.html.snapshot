        </div>
        <!-- Mini gráfico CC -->
        <div class="pres-mini-panel">
          <h4><span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 18c-2.4-1.3-4-3.8-4-6.8C4 6.7 7.6 3 12.1 3S20 6.4 20 10.7c0 3.5-1.8 6.3-4.6 7.7"/><path d="M8 18v2h8v-2"/><path d="M9 9.5h.01M15 9.5h.01"/></svg></span>&nbsp;Encefalización comparada</h4>
          <canvas id="presCCChart" height="110" role="img" aria-label="Gráfico de encefalización comparada en modo presentación"><p>Gráfico de evolución de la capacidad craneal en homininos. Requiere Canvas HTML5.</p></canvas>
          <div style="margin-top:5px;font-size:0.7rem;color:rgba(255,255,255,0.35);font-family:'JetBrains Mono',monospace"
               id="presCCLabel"></div>
        </div>
      </div>

    </div><!-- /pres-info-panel -->
  </div><!-- /pres-main -->

