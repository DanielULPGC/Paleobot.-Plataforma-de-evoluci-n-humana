      <button type="button" data-view="phylo"><b>03</b><strong>Filogenia</strong><span>Hipótesis, consenso y comparación.</span></button>
      <button type="button" data-view="genomica"><b>04</b><strong>Paleogenómica</strong><span>ADN, proteínas y límites de conservación.</span></button>
