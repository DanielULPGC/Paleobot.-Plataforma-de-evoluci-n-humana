            <span><i class="pres-map-symbol peer" aria-hidden="true"></i> yacimientos próximos</span>
            <span><i class="pres-map-symbol scale" aria-hidden="true"></i> escala aproximada</span>
          </div>
          <button type="button" class="pres-map-expand-btn" data-pres-map-expand>
            <span class="ico" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg></span>
