<!--
  ╔══════════════════════════════════════════════════════════════╗
  ║  PaleoBot — Atlas Paleoantropológico Interactivo             ║
  ║  Versión: 66.0.0  (v66: M1+M2+M3+M4+M5)                     ║
  ║  Fecha:   2026-05                                            ║
  ║  Mejoras v66:                                                ║
  ║    M1   Dispatcher canónico de clicks (capture:true, FIFO)  ║
  ║    M2   Exportación SVG árbol filogenético (phylo+constructor║
  ║    M3   Generador SA desde sesión + panel Bloom + Moodle-txt ║
  ║    M4   Fauna asociada 43 yacimientos (taxa, bioma, riqueza) ║
  ║    M5   Viewer craneal multi-norma: lateral/frontal/superior ║
  ║         · SVG norma superior paramétrico (índice cefálico,  ║
  ║           bun occipital, arcos cigomáticos, cresta sagital) ║
  ║         · Selector accesible [aria-pressed] entre 3 vistas  ║
  ║  Base:    paleobot_v32.html                                  ║
  ║  Mejoras v33:                                                ║
  ║    V33-1  introgresion añadida a COMPLEXITY_MODES.           ║
  ║           universitario.views (era invisible en ese modo)    ║
  ║    V33-2  VIEW_HERO_META, VIEW_CONTEXT_NEXT y                ║
  ║           VIEW_EXIT_PRODUCTS registrados para las 3 vistas   ║
  ║    V33-3  FIX: escala visual barra porcentaje introgresión   ║
  ║           (pctMid*10 → mapeo 0-20% → 0-100% visual)         ║
  ║    V33-4  Tafonomía: silueta anatómica SVG real (path        ║
  ║           anatómicos: costillas, vértebras, extremidades)    ║
  ║           + radio dinámico por supervivencia                 ║
  ║    V33-5  Tafonomía: tabla de regiones ordenadas por         ║
  ║           supervivencia con barras de progreso accesibles    ║
  ║    V33-6  Estratigrafía: indicador visual [DEBATIDO]         ║
  ║           (borde naranja punteado + ? en SVG + leyenda)      ║
  ║    V33-7  Estratigrafía: panel Comparar yacimientos          ║
  ║           (tabla: capas, rango temporal, taxones, métodos)   ║
  ║    V33-8  Introgresión: arrowhead markers direccionales       ║
  ║           en ribbons Bézier + eje temporal Ka superior       ║
  ║    V33-9  Introgresión: badge visual PROVISIONAL (círculo    ║
  ║           punteado naranja + ? en nodo arcaico)              ║
  ║    V33-10 CSS: scroll-margin-top, .tapho-region-table,       ║
  ║           .strat-compare-table, .strat-debated-legend        ║
  ║  Fuentes de datos: DB[].experto.referencias (DOI en línea)  ║
  ╚══════════════════════════════════════════════════════════════╝
<!--
  ║  Correcciones heredadas de v27 (v27.1.0):                    ║
  ║    S-1  <div role=main> → <main> nativo                     ║
  ║    A-7  <canvas> con role=img + aria-label                   ║
  ║    A-8  confirm() → diálogo accesible inline                 ║
  ║    A-9  Glosario nav con role=navigation + aria-label        ║
  ║    M-11 Font-family tokens en cabeceras de módulo            ║
  ║    M-12 <meta theme-color> + <link rel=icon>                ║
  ║    M-13 <title> y <meta description> actualizados           ║
  ║  Mejoras nuevas v28:                                         ║
  ║    CMP-1  Picker de buscador con dropdown filtrable          ║
  ║           (reemplaza los 2 <select> legacy)                  ║
  ║    CMP-2  Chips eliminables con animación por clado          ║
  ║    CMP-3  Presets curriculares (6 escenarios pedagógicos)     ║
  ║    CMP-4  Radar morfofuncional Canvas2D — 6 ejes:            ║
  ║           encefalización, bipedismo, tecnología lítica,      ║
  ║           robustez masticatoria, arborealismo, simbolismo    ║
  ║    CMP-5  Tabla de rasgos N-columnar dinámica                ║
  ║    CMP-6  Grid visual morfológico N×5 caracteres             ║
  ║    CMP-7  Cladística generalizada: universales + autapos     ║
  ║    CMP-8  Textos paralelos de anatomía y debate N columnas   ║
  ║    CMP-9  getMorphRadarScore() — scoring morfofuncional       ║
  ║           basado en CHARACTER_CATALOG + CHARACTER_OVERRIDES  ║
  ║    CMP-10 Compatibilidad backward con renderComparison()     ║
  ║  Fuentes de datos: DB[].experto.referencias (DOI en línea)  ║
  ╚══════════════════════════════════════════════════════════════╝
-->
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- CSP docente restrictiva: conserva scripts inline heredados, pero bloquea
       conexiones IA directas. Para IA externa usar proxy institucional same-origin. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://upload.wikimedia.org https://commons.wikimedia.org https://maps.wikimedia.org https://*.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; worker-src 'self' blob:; media-src 'self' data: blob:; manifest-src 'self';">
<title>PaleoBot — Atlas Paleoantropológico Interactivo (DEA · ULPGC)</title>
<meta name="description" content="PaleoBot — Atlas Paleoantropológico Interactivo. Corpus integrado de 52 entradas taxonómicas y paleopoblacionales, con 50 fichas avanzadas y módulos de análisis. ULPGC 2026.">
<!-- Fuentes tipográficas con preconnect optimizado y font-display:swap (incluido en URL) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Source+Sans+3:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<!-- FIX M-12: meta theme-color para dispositivos móviles y PWA -->
<meta name="theme-color" content="#1c2b3a">
<!-- FIX M-12: favicon genérico (SVG inline vía data URI, sin dependencias externas) -->
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%231c2b3a'/><text y='24' x='4' font-size='20' font-family='serif'>🦴</text></svg>" type="image/svg+xml">
<!-- Leaflet 1.9.4 — con Subresource Integrity (FIX A-4: protección contra supply-chain attacks) -->
<link rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
  integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer" />
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"
  integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  defer></script>

<link rel="stylesheet" href="assets/css/00-core/001-style.css?v=fix7">
</head>
<body>

<!-- Skip-link de accesibilidad (FIX C-3b — WCAG 2.1 §2.4.1 Bypass Blocks) -->
<a href="#main-content" class="skip-link">Saltar al contenido principal</a>

<!-- FIX UX-ELDERLY (Claude 2026-06): barra visible "ir al atlas" para ratu00f3n/tu00e1ctil.
     El .skip-link estu00e1ndar solo aparece con foco de teclado; esta barra da a
     todo el alumnado un acceso directo de un clic al atlas, saltando la portada
     introductoria. Reversible: borra este bloque para quitarla. -->
<a href="#main-content" id="pb-skip-intro-bar"
   style="display:flex;align-items:center;justify-content:center;gap:12px;width:100%;box-sizing:border-box;padding:16px 24px;background:#102332;color:#fff;text-decoration:none;font-family:'Source Sans 3',system-ui,sans-serif;font-size:1.08rem;font-weight:700;border-bottom:3px solid #d8a93a;line-height:1.3;text-align:center;cursor:pointer;">
  <span style="display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#d8a93a;color:#102332;font-size:1.15rem;flex:0 0 auto;" aria-hidden="true">↓</span>
  <span>Ir directamente al atlas interactivo</span>
</a>
<script>
  /* Handler en captura (registrado durante el parseo, antes que los guards defer/lazy)
     para que el salto al atlas no lo intercepte ningún guard de clic en captura. */
  (function(){
    function protectNutcrackerExternal(ev){
      var link = ev.target && ev.target.closest && ev.target.closest('[data-pbnm-external]');
      if(!link) return;
      if(ev.button && ev.button !== 0) return;
      if(ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.altKey) return;
      var target = link.getAttribute('data-pbnm-external') || link.href || link.getAttribute('href') || '';
      if(!/^https?:\/\//i.test(target)) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      document.documentElement.dataset.pbnmExternalNav = target;
      try {
        if(window.top && window.top !== window){
          window.top.location.assign(target);
          return;
        }
      } catch(_){ }
      window.location.assign(target);
    }
    window.addEventListener('pointerdown', protectNutcrackerExternal, true);
    window.addEventListener('click', protectNutcrackerExternal, true);

    window.addEventListener('click', function(ev){
      var bar = ev.target && ev.target.closest && ev.target.closest('#pb-skip-intro-bar');
      if(!bar) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      var m = document.getElementById('main-content');
      if(m){
        document.body.classList.add('pb-workspace-entered');
        window.scrollTo(0, m.getBoundingClientRect().top + window.pageYOffset - 8);
        m.setAttribute('tabindex','-1');
        try { m.focus({ preventScroll:true }); } catch(_){}
      }
    }, true);

    /* FIX (Claude 2026-06): clic en tarjetas de introgresión. Resiliente a la
       caché: una versión antigua de la capa v64 (035) puede quedar cacheada en el
       navegador; secuestraba el clic e impedía que el panel de detalle se
       rellenara. Este handler en window-capture se ejecuta ANTES que cualquier
       handler en document-capture (incluido el v64 viejo), llama a la API del
       núcleo window.selectIntrogEvent (que sí rellena el panel) y detiene la
       cadena para que el v64 viejo no rebote ni fije pbV50Block='investigar'. */
    window.addEventListener('click', function(ev){
      var card = ev.target && ev.target.closest && ev.target.closest('.introg-photo-card[data-introg-event]');
      if(!card) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(typeof window.selectIntrogEvent === 'function'){
        window.selectIntrogEvent(card.dataset.introgEvent || '');
      }
    }, true);

    window.addEventListener('click', function(ev){
      var toggle = ev.target && ev.target.closest && ev.target.closest('#pb-mobile-tools-toggle');
      if(!toggle) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      var open = !document.body.classList.contains('pb-mobile-tools-open');
      document.body.classList.toggle('pb-mobile-tools-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Cerrar herramientas' : 'Abrir herramientas');
      [document.getElementById('pb-floating-tools'), document.getElementById('pb-a11y-toolbar-root')].forEach(function(panel){
        if(!panel) return;
        panel.setAttribute('aria-hidden', open ? 'false' : 'true');
        if(open) panel.removeAttribute('inert'); else panel.setAttribute('inert','');
      });
      document.documentElement.dataset.pbMobileTools = open ? 'open' : 'closed';
    }, true);

    var protectedBibPointerAt = 0;
    function protectBibliographyFilter(ev){
      var filter = ev.target && ev.target.closest && ev.target.closest('[data-bib-filter]');
      if(!filter) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(ev.type === 'click' && Date.now() - protectedBibPointerAt < 500) return;
      if(ev.type === 'pointerdown') protectedBibPointerAt = Date.now();
      var key = filter.getAttribute('data-bib-filter') || 'all';
      if(window.PaleoBotV38Bibliography && typeof window.PaleoBotV38Bibliography.setBibliographyFilter === 'function') {
        window.PaleoBotV38Bibliography.setBibliographyFilter(key, filter);
      } else {
        document.querySelectorAll('[data-bib-filter]').forEach(function(button){
          var active = button === filter;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      }
      document.body.dataset.pbProtectedBibFilter = key;
    }
    window.addEventListener('pointerdown', protectBibliographyFilter, true);
    window.addEventListener('click', protectBibliographyFilter, true);

    var protectedModalPointerAt = 0;
    function protectModalToggle(ev){
      var trigger = ev.target && ev.target.closest && ev.target.closest('[data-modal-toggle]');
      var modalId = trigger && trigger.getAttribute('data-modal-toggle');
      var modal = modalId && document.getElementById(modalId);
      if(!modal) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(ev.type === 'click' && Date.now() - protectedModalPointerAt < 500) return;
      if(ev.type === 'pointerdown') protectedModalPointerAt = Date.now();
      if(window.PaleoBotV88FloatingMenuFinal && typeof window.PaleoBotV88FloatingMenuFinal.toggleModal === 'function') {
        window.PaleoBotV88FloatingMenuFinal.toggleModal(modalId);
      } else {
        var open = !modal.classList.contains('active');
        modal.classList.toggle('active', open);
        modal.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      document.body.dataset.pbProtectedModal = modalId;
    }
    window.addEventListener('pointerdown', protectModalToggle, true);
    window.addEventListener('click', protectModalToggle, true);

    var protectedQuizPointerAt = 0;
    function protectClassicQuizStart(ev){
      var trigger = ev.target && ev.target.closest && ev.target.closest('[data-quiz-next="classic"]');
      if(!trigger) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(ev.type === 'click' && Date.now() - protectedQuizPointerAt < 500) return;
      if(ev.type === 'pointerdown') protectedQuizPointerAt = Date.now();
      if(typeof window.runExam === 'function') window.runExam();
      document.body.dataset.pbProtectedQuiz = 'classic';
    }
    window.addEventListener('pointerdown', protectClassicQuizStart, true);
    window.addEventListener('click', protectClassicQuizStart, true);

    var protectedAnswerPointerAt = 0;
    function protectM13Answer(ev){
      var answer = ev.target && ev.target.closest && ev.target.closest('[data-m13-answer]');
      if(!answer) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(ev.type === 'click' && Date.now() - protectedAnswerPointerAt < 500) return;
      if(ev.type === 'pointerdown') protectedAnswerPointerAt = Date.now();
      if(window.PaleoBotM13Quiz && typeof window.PaleoBotM13Quiz.answer === 'function') {
        window.PaleoBotM13Quiz.answer(answer);
      }
      document.body.dataset.pbProtectedQuizAnswer = answer.getAttribute('data-m13-answer') || 'answer';
    }
    window.addEventListener('pointerdown', protectM13Answer, true);
    window.addEventListener('click', protectM13Answer, true);

    var protectedModalActions = {
      abrirBiblio:'biblioModal',
      openGlossary:'glossaryModal',
      startExam:'examModal',
      openMatrix:'matrixModal',
      abrirEstadisticas:'statsModal',
      openStudentGuide:'studentGuideModal',
      openSessionSynthesis:'sessionSynthesisModal',
      openCompare:'compareModal'
    };
    window.addEventListener('click', function(ev){
      var trigger = ev.target && ev.target.closest && ev.target.closest('[data-action]');
      var action = trigger && trigger.getAttribute('data-action');
      var modalId = protectedModalActions[action];
      if(!modalId) return;
      ev.preventDefault();
      ev.stopImmediatePropagation();
      if(typeof window[action] === 'function') {
        window[action](trigger, ev);
      } else if(window.PaleoBotV68InteractionStabilizer && typeof window.PaleoBotV68InteractionStabilizer.runAction === 'function') {
        window.PaleoBotV68InteractionStabilizer.runAction(action);
      } else {
        var modal = document.getElementById(modalId);
        if(modal){ modal.classList.add('active'); modal.setAttribute('aria-hidden','false'); }
      }
      document.body.dataset.pbProtectedAction = action;
    }, true);
  })();
</script>

<!-- ════════════════════════════════════════════════════════════════
     HUB DE ENTRADA POR BLOQUES (Claude 2026-06)
     Portada didáctica: 5 bloques grandes e independientes. Al pulsar uno
     se muestran SOLO sus herramientas, con botón claro para volver. Cada
     herramienta navega a su vista del atlas (router verificado) y baja al
     área de trabajo. Capa de presentación nueva; no toca la navegación
     interna. Reversible: borra esta <section> y su <script>.
     ════════════════════════════════════════════════════════════════ -->
<section id="pb-hub" aria-label="Acceso por bloques" style="background:linear-gradient(170deg,#102332 0%,#0c1b27 100%);color:#f3efe7;padding:46px 22px 54px;font-family:'Source Sans 3',system-ui,sans-serif;">
  <div class="pb-landing-shell" style="max-width:1180px;margin:0 auto;">

    <section class="pb-landing-hero" aria-labelledby="pb-landing-title">
      <picture class="pb-landing-hero-media" aria-hidden="true">
        <img
          src="assets/media/landing/hero.jpg"
          alt=""
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
        >
      </picture>
      <div class="pb-landing-hero-content">
        <span class="pb-landing-kicker">Atlas científico y didáctico · Evolución humana</span>
        <h1 id="pb-landing-title">PaleoBot</h1>
        <p class="pb-landing-subtitle">Explora el registro fósil sin perderte en él.</p>
        <p class="pb-landing-lead">Cincuenta y dos entradas, treinta y una vistas de trabajo y cinco rutas para comprender&nbsp;<strong>quiénes vivieron, dónde, cuándo y cómo lo sabemos</strong>.</p>
        <div class="pb-landing-hero-actions" aria-label="Accesos principales">
          <a class="pb-landing-cta primary" href="#pb-hub-blocks">Explorar por bloques</a>
          <a class="pb-landing-cta" href="#pb-landing-index">Ver índice completo</a>
          <a class="pb-landing-cta" href="recorrido/index.html" data-pb-integrated-route="recorrido/index.html">Recorrido esencial</a>
        </div>
        <dl class="pb-landing-facts" aria-label="Alcance del atlas">
          <div><dt>52</dt><dd>entradas</dd></div>
          <div><dt>31</dt><dd>vistas</dd></div>
          <div><dt>5</dt><dd>rutas</dd></div>
          <div><dt>DOI</dt><dd>trazables</dd></div>
        </dl>
      </div>
      <p class="pb-landing-credit">Molde craneal de <em>Australopithecus afarensis</em> · Naturmuseum Senckenberg · Daderot, CC0.</p>
    </section>

    <section class="pb-pathways" aria-labelledby="pb-pathways-title">
      <div class="pb-pathways-head">
        <div>
          <span>Dos escalas de lectura</span>
          <h2 id="pb-pathways-title">Elige la profundidad del recorrido</h2>
        </div>
      </div>
      <div class="pb-pathways-grid">
        <a class="pb-pathway essential" href="recorrido/index.html" data-pb-integrated-route="recorrido/index.html">
          <span class="pb-pathway-icon" aria-hidden="true">01</span>
          <span><strong>Recorrido esencial</strong><small>Cincuenta y dos entradas, cinco preguntas y alternativas textuales.</small></span>
          <span class="pb-pathway-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pb-pathway full" href="#pb-hub-blocks">
          <span class="pb-pathway-icon" aria-hidden="true">02</span>
          <span><strong>Laboratorio completo</strong><small>Cincuenta taxones, evidencia visual y herramientas de análisis.</small></span>
          <span class="pb-pathway-arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <script>
      window.addEventListener('click', function(event){
        var route = event.target && event.target.closest &&
          event.target.closest('[data-pb-integrated-route]');
        if (!route) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        window.location.assign(route.getAttribute('data-pb-integrated-route'));
      }, true);
    </script>

    <!-- Objetivos del recurso -->
    <section class="pb-learning-outcomes" aria-labelledby="pb-learning-outcomes-title" style="margin:38px auto 8px;max-width:1000px;">
      <p id="pb-learning-outcomes-title" style="text-align:center;font-family:'JetBrains Mono',monospace;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:#7e8f88;margin:0 0 18px;">Al recorrer este atlas podrás</p>
      <div class="pb-learning-outcomes-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;">
        <div class="pb-learning-outcome" style="display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.03);border:1px solid #21384a;border-radius:14px;padding:18px 20px;">
          <span style="flex:0 0 auto;display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:rgba(19,163,127,.16);color:#3ed3aa;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <span style="font-size:1.02rem;line-height:1.45;color:#cdd9d2;"><strong style="color:#f3efe7;font-weight:600;">Situar</strong> en el tiempo y el espacio a las especies humanas.</span>
        </div>
        <div class="pb-learning-outcome" style="display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.03);border:1px solid #21384a;border-radius:14px;padding:18px 20px;">
          <span style="flex:0 0 auto;display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:rgba(199,144,48,.16);color:#e0b15c;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v6l-5 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 3h8"/></svg></span>
          <span style="font-size:1.02rem;line-height:1.45;color:#cdd9d2;"><strong style="color:#f3efe7;font-weight:600;">Comprender</strong> cómo se obtiene el conocimiento: datación, ADN antiguo y paleoproteómica.</span>
        </div>
        <div class="pb-learning-outcome" style="display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,.03);border:1px solid #21384a;border-radius:14px;padding:18px 20px;">
          <span style="flex:0 0 auto;display:grid;place-items:center;width:40px;height:40px;border-radius:11px;background:rgba(79,134,214,.16);color:#7fb0f0;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg></span>
          <span style="font-size:1.02rem;line-height:1.45;color:#cdd9d2;"><strong style="color:#f3efe7;font-weight:600;">Interpretar</strong> la evidencia con criterio, conociendo los debates aún abiertos.</span>
        </div>
      </div>
    </section>

    <!-- Orientación: cómo usarlo -->
    <div class="pb-landing-steps" style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;margin:26px auto 6px;max-width:920px;color:#9fb0a8;font-size:.98rem;">
      <span style="display:inline-flex;align-items:center;gap:8px;"><span style="color:#d8a93a;font-weight:700;">1.</span> Elige un bloque para empezar</span>
      <span style="display:inline-flex;align-items:center;gap:8px;"><span style="color:#d8a93a;font-weight:700;">2.</span> Cada bloque reúne sus propias herramientas</span>
      <span style="display:inline-flex;align-items:center;gap:8px;"><span style="color:#d8a93a;font-weight:700;">3.</span> Avanza a tu ritmo y vuelve cuando quieras</span>
    </div>

    <!-- Separador hacia los bloques -->
    <div class="pb-blocks-heading" style="display:flex;align-items:center;gap:18px;margin:40px auto 28px;max-width:760px;">
      <span style="flex:1;height:1px;background:linear-gradient(90deg,transparent,#2a4357);"></span>
      <h2 style="font-family:Georgia,serif;font-size:clamp(1.5rem,3vw,2rem);font-weight:700;margin:0;color:#f3efe7;text-align:center;white-space:nowrap;">Elige por dónde empezar</h2>
      <span style="flex:1;height:1px;background:linear-gradient(90deg,#2a4357,transparent);"></span>
    </div>

    <!-- Nivel 1: rejilla de bloques -->
    <div id="pb-hub-blocks" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;">
      <button type="button" class="pb-hub-card" data-hub-block="cronologia" data-action="openLandingBlock" aria-controls="pb-hub-tools" aria-expanded="false" style="--c:#13a37f;text-align:left;cursor:pointer;background:#16293a;border:1px solid #2a4357;border-top:5px solid #13a37f;border-radius:18px;padding:26px 24px;color:#f3efe7;font:inherit;transition:transform .15s,box-shadow .15s,border-color .15s;">
        <figure class="pb-hub-card-media">
          <img src="assets/media/landing/chronology.jpg" alt="Conjunto de cráneos fósiles homininos expuestos en un museo" loading="lazy" decoding="async">
          <figcaption>Registro fósil · Museum of Osteology</figcaption>
        </figure>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
          <span style="display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:rgba(19,163,127,.16);color:#3ed3aa;flex:0 0 auto;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.78rem;color:#7e8f88;">01 · 7 herramientas</span>
        </div>
        <strong style="display:block;font-family:Georgia,serif;font-size:1.5rem;margin-bottom:6px;">Cronología y especies</strong>
        <span style="display:block;font-size:1rem;color:#aebbb4;line-height:1.45;">¿Quiénes vivieron y cuándo? Línea del tiempo, árbol, coexistencias y fichas.</span>
      </button>

      <button type="button" class="pb-hub-card" data-hub-block="territorio" data-action="openLandingBlock" aria-controls="pb-hub-tools" aria-expanded="false" style="--c:#4f86d6;text-align:left;cursor:pointer;background:#16293a;border:1px solid #2a4357;border-top:5px solid #4f86d6;border-radius:18px;padding:26px 24px;color:#f3efe7;font:inherit;transition:transform .15s,box-shadow .15s,border-color .15s;">
        <figure class="pb-hub-card-media">
          <img src="assets/media/landing/territory.jpg" alt="Paisaje real de la garganta de Olduvai en Tanzania" loading="lazy" decoding="async">
          <figcaption>Territorio · Garganta de Olduvai</figcaption>
        </figure>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
          <span style="display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:rgba(79,134,214,.16);color:#7fb0f0;flex:0 0 auto;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.78rem;color:#7e8f88;">02 · 9 herramientas</span>
        </div>
        <strong style="display:block;font-family:Georgia,serif;font-size:1.5rem;margin-bottom:6px;">Territorio y dispersión</strong>
        <span style="display:block;font-size:1rem;color:#aebbb4;line-height:1.45;">¿Dónde vivieron? Mapa, continentes, yacimientos y salida de África.</span>
      </button>

      <button type="button" class="pb-hub-card" data-hub-block="clima" data-action="openLandingBlock" aria-controls="pb-hub-tools" aria-expanded="false" style="--c:#8aa83d;text-align:left;cursor:pointer;background:#16293a;border:1px solid #2a4357;border-top:5px solid #8aa83d;border-radius:18px;padding:26px 24px;color:#f3efe7;font:inherit;transition:transform .15s,box-shadow .15s,border-color .15s;">
        <figure class="pb-hub-card-media">
          <img src="assets/media/landing/climate.jpg" alt="Científico describiendo un testigo sedimentario usado como archivo paleoclimático" loading="lazy" decoding="async">
          <figcaption>Paleoclima · Testigo sedimentario</figcaption>
        </figure>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
          <span style="display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:rgba(138,168,61,.16);color:#b6d16a;flex:0 0 auto;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a9 9 0 1 0 9 9"/><path d="M12 2v9l5 3"/><path d="M3.5 9h6"/></svg></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.78rem;color:#7e8f88;">03 · 3 herramientas</span>
        </div>
        <strong style="display:block;font-family:Georgia,serif;font-size:1.5rem;margin-bottom:6px;">Clima y ecología</strong>
        <span style="display:block;font-size:1rem;color:#aebbb4;line-height:1.45;">¿En qué mundo? Paleoclima, contexto ambiental y ecología.</span>
      </button>

      <button type="button" class="pb-hub-card" data-hub-block="metodos" data-action="openLandingBlock" aria-controls="pb-hub-tools" aria-expanded="false" style="--c:#c79030;text-align:left;cursor:pointer;background:#16293a;border:1px solid #2a4357;border-top:5px solid #c79030;border-radius:18px;padding:26px 24px;color:#f3efe7;font:inherit;transition:transform .15s,box-shadow .15s,border-color .15s;">
        <figure class="pb-hub-card-media">
          <img src="assets/media/landing/methods.jpg" alt="Excavación arqueológica de la capa con fósiles de Nesher Ramla Homo" loading="lazy" decoding="async">
          <figcaption>Método · Excavación estratigráfica</figcaption>
        </figure>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
          <span style="display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:rgba(199,144,48,.16);color:#e0b15c;flex:0 0 auto;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v6l-5 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-9V3"/><path d="M8 3h8M8 13h8"/></svg></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.78rem;color:#7e8f88;">04 · 9 herramientas</span>
        </div>
        <strong style="display:block;font-family:Georgia,serif;font-size:1.5rem;margin-bottom:6px;">Métodos y evidencia</strong>
        <span style="display:block;font-size:1rem;color:#aebbb4;line-height:1.45;">¿Cómo lo sabemos? Datación, ADN antiguo,&nbsp;<em>paleoproteómica</em>&nbsp;y debate.</span>
      </button>

      <button type="button" class="pb-hub-card" data-hub-block="aula" data-action="openLandingBlock" aria-controls="pb-hub-tools" aria-expanded="false" style="--c:#c4622f;text-align:left;cursor:pointer;background:#16293a;border:1px solid #2a4357;border-top:5px solid #c4622f;border-radius:18px;padding:26px 24px;color:#f3efe7;font:inherit;transition:transform .15s,box-shadow .15s,border-color .15s;">
        <figure class="pb-hub-card-media">
          <img src="assets/media/landing/classroom.jpg" alt="Estudiantes de Biología comparando réplicas de cráneos homininos" loading="lazy" decoding="async">
          <figcaption>Didáctica · Comparación de réplicas</figcaption>
        </figure>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
          <span style="display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:rgba(196,98,47,.16);color:#e2895c;flex:0 0 auto;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1 3 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg></span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.78rem;color:#7e8f88;">05 · 4 herramientas</span>
        </div>
        <strong style="display:block;font-family:Georgia,serif;font-size:1.5rem;margin-bottom:6px;">Aula y recursos</strong>
        <span style="display:block;font-size:1rem;color:#aebbb4;line-height:1.45;">Enseñar y evaluar: rutas de clase, itinerarios, recursos y laboratorio comparativo.</span>
      </button>
    </div>

    <!-- Nivel 2: herramientas del bloque seleccionado -->
    <div id="pb-hub-tools" style="display:none;">
      <button type="button" id="pb-hub-back" data-action="showLandingBlocks" style="display:inline-flex;align-items:center;gap:8px;font:inherit;font-size:1rem;font-weight:600;color:#102332;background:#d8a93a;border:none;border-radius:10px;padding:11px 20px;cursor:pointer;margin-bottom:22px;">← Volver a los bloques</button>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:6px;">
        <span id="pb-hub-tools-dot" style="width:16px;height:16px;border-radius:5px;background:#13a37f;flex:0 0 auto;"></span>
        <h2 id="pb-hub-tools-title" style="font-family:Georgia,serif;font-size:1.7rem;margin:0;color:#f3efe7;">Bloque</h2>
      </div>
      <p id="pb-hub-tools-sub" style="font-size:1.02rem;color:#aebbb4;margin:0 0 22px;"></p>
      <div id="pb-hub-tools-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;"></div>
    </div>

    <section class="pb-evidence-lab" aria-labelledby="pb-evidence-lab-title">
      <div class="pb-evidence-lab-head">
        <span>Laboratorio de observación</span>
        <h2 id="pb-evidence-lab-title">Tres evidencias, tres preguntas científicas</h2>
        <p>Las imágenes no son decoración: cada una abre una tarea breve de observación, interpretación y contraste con los datos del atlas.</p>
      </div>
      <div class="pb-evidence-lab-grid">
        <article class="pb-evidence-item">
          <figure>
            <img src="assets/media/institutional/smithsonian-hominin-crania.webp" alt="Tres cráneos homininos: Australopithecus africanus, Homo sapiens y Homo erectus" loading="lazy" decoding="async">
            <figcaption>Smithsonian NMNH, Human Origins Program</figcaption>
          </figure>
          <div>
            <span class="pb-evidence-step">01 · Observar</span>
            <h3>¿Qué rasgos cambian y cuáles se conservan?</h3>
            <p>Compara forma de la bóveda, proyección facial y tamaño relativo. Separa lo que ves de la explicación que propones.</p>
            <button type="button" data-hub-view="phylo">Contrastar en Filogenia</button>
          </div>
        </article>
        <article class="pb-evidence-item">
          <figure>
            <img src="assets/media/institutional/smithsonian-olduvai-chopper.webp" alt="Canto tallado procedente de África oriental conservado por el Smithsonian" loading="lazy" decoding="async">
            <figcaption>Smithsonian NMNH, fotografía de Chip Clark</figcaption>
          </figure>
          <div>
            <span class="pb-evidence-step">02 · Inferir</span>
            <h3>¿Qué conducta permite inferir una herramienta?</h3>
            <p>Identifica huellas de modificación y plantea al menos una interpretación alternativa antes de atribuir una función.</p>
            <button type="button" data-hub-view="tafonomia">Abrir Tafonomía</button>
          </div>
        </article>
        <article class="pb-evidence-item">
          <figure>
            <img src="assets/media/institutional/nhm-gibraltar-neanderthal.jpg" alt="Vista frontal del cráneo neandertal Gibraltar 1" loading="lazy" decoding="async">
            <figcaption>Natural History Museum, London · Gibraltar 1</figcaption>
          </figure>
          <div>
            <span class="pb-evidence-step">03 · Contrastar</span>
            <h3>¿Puede un fósil responder por sí solo?</h3>
            <p>Relaciona anatomía, datación y ADN antiguo. Señala qué afirmaciones dependen de una sola línea de evidencia.</p>
            <button type="button" data-hub-view="introgresion">Examinar Introgresión</button>
          </div>
        </article>
      </div>
    </section>

    <section class="pb-landing-index" id="pb-landing-index" aria-labelledby="pb-landing-index-title">
      <div class="pb-landing-index-head">
        <span>Mapa de contenidos</span>
        <h2 id="pb-landing-index-title">Índice completo del atlas</h2>
        <p>Accede directamente a cualquier herramienta. Cada destino conserva su bloque y activa una única vista de trabajo.</p>
      </div>
      <div class="pb-landing-index-grid" id="pb-landing-index-grid"></div>
      <details class="pb-landing-sources">
        <summary>Procedencia y licencias de las imágenes de portada</summary>
        <ul>
          <li><a href="https://commons.wikimedia.org/wiki/File:Australopithecus_afarensis_skull_-_Naturmuseum_Senckenberg_-_DSC02102.JPG" target="_blank" rel="noopener noreferrer"><em>Australopithecus afarensis</em></a>, Daderot, CC0.</li>
          <li><a href="https://commons.wikimedia.org/wiki/File:Fossil_hominids.jpg" target="_blank" rel="noopener noreferrer">Exposición de cráneos homininos</a>, Sklmsta, CC0.</li>
          <li><a href="https://commons.wikimedia.org/wiki/File:Olduvai_Gorge_or_Oldupai_Gorge.jpg" target="_blank" rel="noopener noreferrer">Garganta de Olduvai</a>, Noel Feans, CC BY 2.0.</li>
          <li><a href="https://commons.wikimedia.org/wiki/File:Sediment-core-description_hg.jpg" target="_blank" rel="noopener noreferrer">Descripción de un testigo sedimentario</a>, Hannes Grobe/AWI, CC BY 3.0.</li>
          <li><a href="https://commons.wikimedia.org/wiki/File:Excavation_of_the_layer_with_fossils_of_Nesher_Ramla_Homo.jpg" target="_blank" rel="noopener noreferrer">Excavación de Nesher Ramla</a>, Yossi Zaidner, CC BY-SA 4.0.</li>
          <li><a href="https://commons.wikimedia.org/wiki/File:Students_explore_hominid_evolution.jpg" target="_blank" rel="noopener noreferrer">Estudiantes comparando réplicas</a>, Carolyn Wilczynski, CC BY 4.0.</li>
          <li><a href="https://naturalhistory.si.edu/education/teaching-resources/anthropology-and-social-studies/human-evolution" target="_blank" rel="noopener noreferrer">Tres cráneos homininos</a>, Human Origins Program, Smithsonian NMNH; imagen institucional identificada como Smithsonian PD.</li>
          <li><a href="https://naturalhistory.si.edu/education/teaching-resources/anthropology-and-social-studies/early-human-evolution-and-culture" target="_blank" rel="noopener noreferrer">Herramienta lítica de África oriental</a>, Smithsonian NMNH, fotografía de Chip Clark; uso educativo sujeto a las condiciones del Smithsonian.</li>
          <li><a href="https://www.nhm.ac.uk/discover/first-adult-neanderthal-skull.html" target="_blank" rel="noopener noreferrer">Cráneo neandertal Gibraltar 1</a>, Natural History Museum, London; uso educativo con atribución y sujeto a las condiciones del museo.</li>
        </ul>
      </details>
    </section>

    <div style="text-align:center;margin-top:32px;">
      <a href="#main-content" id="pb-hub-skip" style="font-size:.96rem;color:#8fa39a;text-decoration:none;border-bottom:1px dotted #5d6f66;padding-bottom:2px;">o entrar directamente al atlas completo ↓</a>
    </div>
  </div>
</section>
<script>
  /* Lógica del HUB de bloques (Claude 2026-06). Carga durante el parseo, antes
     que los guards diferidos. Navega vía el router verificado y baja al atlas. */
  (function(){
    var L = {
      timeline:'Cronología', tree:'Árbol de consenso', phylo:'Filogenia',
      coexistencias:'Coexistencias', holotipos:'Holotipos', revisiones:'Revisiones', primatologia:'Primatología',
      map:'Mapa', continentes:'Continentes', africa:'África', asia:'Asia', europe:'Europa', america:'América',
      yacimientos:'Yacimientos', biogeo:'Biogeografía', dispersal:'Dispersión',
      contexto:'Contexto', clima:'Clima', paleoecologia:'Paleoecología',
      genomica:'Paleogenómica', paleoproteomica:'Paleoproteómica', datacion:'Datación',
      estratigrafia:'Estratigrafía', tafonomia:'Tafonomía', introgresion:'Introgresión',
      constructor:'Constructor', debates:'Debates', socratico:'Socrático',
      aula:'Aula', recursos:'Recursos', itinerarios:'Itinerarios', paleolab:'PaleoLab 50'
    };
    var BLOCKS = {
      cronologia:{ c:'#13a37f', title:'Cronología y especies', sub:'¿Quiénes vivieron y cuándo?', defaultView:'timeline',
        views:['timeline','tree','phylo','coexistencias','holotipos','revisiones','primatologia'] },
      territorio:{ c:'#4f86d6', title:'Territorio y dispersión', sub:'¿Dónde vivieron y por dónde se movieron?', defaultView:'map',
        views:['map','continentes','africa','asia','europe','america','yacimientos','biogeo','dispersal'] },
      clima:{ c:'#8aa83d', title:'Clima y ecología', sub:'¿En qué mundo vivieron?', defaultView:'clima',
        views:['clima','contexto','paleoecologia'] },
      metodos:{ c:'#c79030', title:'Métodos y evidencia', sub:'¿Cómo lo sabemos? Incluye la nueva Paleoproteómica.', defaultView:'genomica',
        views:['genomica','paleoproteomica','datacion','estratigrafia','tafonomia','introgresion','constructor','debates','socratico'] },
      aula:{ c:'#c4622f', title:'Aula y recursos', sub:'Enseñar y evaluar con el atlas.', defaultView:'aula',
        views:['aula','recursos','itinerarios','paleolab'] }
    };
    var NEW = { paleoproteomica:true, paleolab:true };
    var lastBlockTrigger = null;

    function activateHubView(view){
      var section = document.getElementById('view-' + view);
      if (!section) return false;
      try {
        if (window.PaleoBotCanonicalNav) {
          window.PaleoBotCanonicalNav.setCanonical?.(view);
          window.PaleoBotCanonicalNav.domActivate?.(view);
        }
      } catch(_){}
      try {
        if (window.PaleoBotV91FinalButtonActions && window.PaleoBotV91FinalButtonActions.routeView)
          window.PaleoBotV91FinalButtonActions.routeView(view);
        else if (window.PaleoBotV55Router && window.PaleoBotV55Router.activateView)
          window.PaleoBotV55Router.activateView(view, { scroll:false });
        else if (window.PaleoBotV68InteractionStabilizer && window.PaleoBotV68InteractionStabilizer.routeView)
          window.PaleoBotV68InteractionStabilizer.routeView(view);
        else if (typeof window.renderActiveView === 'function')
          window.renderActiveView(view);
      } catch(_){}
      return document.getElementById('view-' + view)?.classList.contains('active') || false;
    }

    function goView(view){
      if (!activateHubView(view)) return;
      document.body.classList.add('pb-workspace-entered');
      var m = document.getElementById('main-content');
      if (!m) return;
      m.setAttribute('tabindex','-1');
      if (window.location.hash !== '#main-content') window.location.hash = 'main-content';
      try { m.scrollIntoView({ behavior:'auto', block:'start' }); } catch(e){}
      var tries = 0;
      function settle(){
        var sec = document.getElementById('view-' + view);
        if (sec && !sec.classList.contains('active')) {
          try {
            window.PaleoBotCanonicalNav?.setCanonical?.(view);
            window.PaleoBotCanonicalNav?.domActivate?.(view);
          } catch(_){}
        }
        try { m.scrollIntoView({ behavior:'auto', block:'start' }); } catch(e){}
        tries++;
        if (tries < 3 && sec && !sec.classList.contains('active')) setTimeout(settle, 90);
      }
      setTimeout(settle, 60);
      try { m.focus(); } catch(e){}
    }

    function openBlock(key){
      var b = BLOCKS[key]; if(!b) return;
      lastBlockTrigger = document.querySelector('.pb-hub-card[data-hub-block="' + key + '"]');
      document.querySelectorAll('.pb-hub-card[data-hub-block]').forEach(function(card){
        card.setAttribute('aria-expanded', card === lastBlockTrigger ? 'true' : 'false');
      });
      document.getElementById('pb-hub-blocks').style.display = 'none';
      var panel = document.getElementById('pb-hub-tools');
      panel.style.display = 'block';
      document.getElementById('pb-hub-tools-dot').style.background = b.c;
      document.getElementById('pb-hub-tools-title').textContent = b.title;
      document.getElementById('pb-hub-tools-sub').textContent = b.sub;
      var grid = document.getElementById('pb-hub-tools-grid');
      grid.innerHTML = '';
      b.views.forEach(function(v){
        var btn = document.createElement('button');
        btn.type = 'button';
        if (v === 'paleolab') {
          btn.setAttribute('data-paleolab-open', '');
          btn.setAttribute('data-action', 'openPaleoLab');
          btn.setAttribute('aria-haspopup', 'dialog');
          btn.setAttribute('aria-controls', 'splDialog');
        } else {
          btn.setAttribute('data-hub-view', v);
        }
        btn.setAttribute('aria-label', 'Abrir ' + (L[v] || v));
        btn.style.cssText = 'text-align:left;cursor:pointer;font:inherit;background:#1b3144;border:1px solid #2a4357;border-left:4px solid '+b.c+';border-radius:11px;padding:15px 16px;color:#f3efe7;font-size:1.05rem;font-weight:600;display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:56px;';
        var label = (L[v]||v);
        btn.innerHTML = '<span>'+label+(NEW[v]?' <span style="font-family:JetBrains Mono,monospace;font-size:.6rem;letter-spacing:.08em;color:#102332;background:#d8a93a;border-radius:5px;padding:2px 6px;vertical-align:middle;margin-left:4px;">NUEVO</span>':'')+'</span><span style="color:'+b.c+';font-size:1.1rem;">→</span>';
        grid.appendChild(btn);
      });
      try { panel.scrollIntoView({block:'start'}); } catch(e){}
      try { document.getElementById('pb-hub-back').focus({preventScroll:true}); } catch(e){}
    }
    function backToBlocks(){
      document.getElementById('pb-hub-tools').style.display = 'none';
      document.getElementById('pb-hub-blocks').style.display = 'grid';
      document.querySelectorAll('.pb-hub-card[data-hub-block]').forEach(function(card){
        card.setAttribute('aria-expanded','false');
      });
      try { lastBlockTrigger?.focus({preventScroll:true}); } catch(e){}
    }

    function renderIndex(){
      var host = document.getElementById('pb-landing-index-grid');
      if (!host || host.children.length) return;
      Object.keys(BLOCKS).forEach(function(key){
        var block = BLOCKS[key];
        var group = document.createElement('section');
        group.className = 'pb-landing-index-group';
        group.style.setProperty('--c', block.c);
        var heading = document.createElement('h3');
        heading.textContent = block.title;
        var count = document.createElement('span');
        count.textContent = block.views.length + (block.views.length === 1 ? ' vista' : ' vistas');
        var links = document.createElement('div');
        links.className = 'pb-landing-index-links';
        block.views.forEach(function(view){
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'pb-landing-index-link';
          button.setAttribute('aria-label','Abrir ' + (L[view] || view));
          if (view === 'paleolab') {
            button.setAttribute('data-paleolab-open','');
            button.setAttribute('data-action','openPaleoLab');
            button.setAttribute('aria-haspopup','dialog');
            button.setAttribute('aria-controls','splDialog');
          } else {
            button.setAttribute('data-hub-view',view);
          }
          var label = document.createElement('span');
          label.textContent = L[view] || view;
          button.appendChild(label);
          if (NEW[view]) {
            var badge = document.createElement('small');
            badge.textContent = 'NUEVO';
            button.appendChild(badge);
          }
          links.appendChild(button);
        });
        group.appendChild(heading);
        group.appendChild(count);
        group.appendChild(links);
        host.appendChild(group);
      });
    }

    window.PaleoBotLanding = Object.freeze({
      openBlock: openBlock,
      showBlocks: backToBlocks,
      goView: goView,
      renderIndex: renderIndex
    });
    renderIndex();

    window.addEventListener('click', function(ev){
      var tool = ev.target.closest && ev.target.closest('[data-hub-view]');
      if (tool){ ev.preventDefault(); ev.stopImmediatePropagation(); goView(tool.getAttribute('data-hub-view')); return; }
      var card = ev.target.closest && ev.target.closest('.pb-hub-card[data-hub-block]');
      if (card){ ev.preventDefault(); ev.stopImmediatePropagation(); openBlock(card.getAttribute('data-hub-block')); return; }
      var back = ev.target.closest && ev.target.closest('#pb-hub-back');
      if (back){ ev.preventDefault(); ev.stopImmediatePropagation(); backToBlocks(); return; }
      var skip = ev.target.closest && ev.target.closest('#pb-hub-skip');
      if (skip){ ev.preventDefault(); ev.stopImmediatePropagation(); var m=document.getElementById('main-content'); if(m){ document.body.classList.add('pb-workspace-entered'); window.scrollTo(0, m.getBoundingClientRect().top+window.pageYOffset-8); } return; }
    }, true);

    document.addEventListener('mouseover', function(ev){
      var c = ev.target.closest && ev.target.closest('.pb-hub-card');
      if (c){ c.style.transform='translateY(-3px)'; c.style.boxShadow='0 14px 30px rgba(0,0,0,.32)'; c.style.borderColor=c.style.getPropertyValue('--c'); }
    });
    document.addEventListener('mouseout', function(ev){
      var c = ev.target.closest && ev.target.closest('.pb-hub-card');
      if (c){ c.style.transform='none'; c.style.boxShadow='none'; c.style.borderColor='#2a4357'; }
    });
  })();
</script>

