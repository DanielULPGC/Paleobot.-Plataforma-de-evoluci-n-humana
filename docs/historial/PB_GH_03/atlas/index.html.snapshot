      </button>
      <button type="button" class="pres-close-btn" data-pres-close aria-label="Cerrar modo presentación">✕</button>
    </div>
  </div>

  <!-- MAIN SLIDE -->
  <div class="pres-main">

    <!-- LEFT: IMAGE -->
