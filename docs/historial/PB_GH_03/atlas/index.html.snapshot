      <div class="pres-teaching-card" id="presTeachingCard"></div>

      <div class="pres-data-row">
        <!-- Mini mapa -->
        <div class="pres-mini-panel">
          <h4><span class="ico" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></span>&nbsp;Yacimiento</h4>
          <div class="pres-map-mini is-clickable" data-pres-map-expand role="button" tabindex="0" aria-label="Ampliar mapa del yacimiento">
