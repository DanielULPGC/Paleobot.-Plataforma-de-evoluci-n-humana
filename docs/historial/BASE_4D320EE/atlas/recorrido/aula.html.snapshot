<style>
:root{--fondo:#0d2028;--fondo-alt:#16303c;--tinta:#f3efe7;--tinta-suave:#c8d2ce;--acento:#d8a93a;--radio:12px;
  --ft:'Playfair Display',Georgia,serif;--fc:'Source Sans 3','Segoe UI',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--fondo);color:var(--tinta);font-family:var(--fc);line-height:1.65}
a{color:var(--acento)}
.salto{position:absolute;left:-999px;top:0;background:var(--acento);color:#141008;padding:.7rem 1.1rem;z-index:50;font-weight:600}
.salto:focus{left:0}
.barra{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.9rem 5vw;background:rgba(13,32,40,.92);backdrop-filter:blur(8px);border-bottom:1px solid rgba(255,255,255,.08)}
.volver{display:inline-flex;align-items:center;gap:.5rem;color:var(--tinta);text-decoration:none;font-weight:600;padding:.5rem .9rem;border-radius:var(--radio);border:1px solid rgba(243,239,231,.2)}
.volver:hover{border-color:var(--acento);color:var(--acento)}
.volver:focus-visible{outline:3px solid var(--acento);outline-offset:2px}
.volver svg{width:18px;height:18px}
.barra .marca{font-weight:600;color:var(--tinta-suave);font-size:.95rem}
.barra nav{display:flex;gap:1.1rem}
.barra nav a{color:var(--acento);text-decoration:none;font-weight:600;font-size:.92rem}

.envoltorio{max-width:980px;margin:0 auto;padding:6vh 5vw 8vh}
.cabecera .k{font-size:.8rem;letter-spacing:.22em;text-transform:uppercase;color:var(--acento);font-weight:600;margin-bottom:.8rem}
.cabecera h1{font-family:var(--ft);font-weight:700;font-size:clamp(1.9rem,5vw,3.2rem);margin-bottom:.6rem}
.cabecera p{color:var(--tinta-suave);max-width:72ch}

h2.sec{font-family:var(--ft);font-weight:700;font-size:1.5rem;margin:2.6rem 0 1rem;padding-bottom:.4rem;border-bottom:1px solid rgba(255,255,255,.12)}
h3{font-size:1.1rem;font-weight:700;margin:1.2rem 0 .3rem}
p{color:var(--tinta);margin-bottom:.7rem}
.caja{background:rgba(216,169,58,.07);border:1px solid rgba(216,169,58,.32);border-radius:var(--radio);padding:1rem 1.2rem;font-size:.92rem;color:var(--tinta-suave);margin:1rem 0}
.tarjeta{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-left:4px solid var(--acento);border-radius:var(--radio);padding:1.4rem 1.6rem;margin-top:1rem}
.tarjeta h3{margin-top:0;color:var(--tinta)}
.tarjeta .ruta{color:var(--tinta-suave);font-size:.95rem}
.tarjeta .ruta a{font-weight:600}
.meta-linea{color:var(--acento);font-size:.85rem;font-weight:600;margin-top:.5rem}
ul,ol{margin:.4rem 0 .8rem 1.3rem;color:var(--tinta-suave)}
li{margin-bottom:.35rem}
.sda{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.12);border-radius:var(--radio);padding:1.6rem 1.8rem;margin-top:1rem}
.sda dl{display:grid;grid-template-columns:auto 1fr;gap:.4rem 1rem;margin:.6rem 0}
.sda dt{color:var(--acento);font-weight:600}
.sda dd{color:var(--tinta-suave)}
.refs{font-size:.9rem;color:rgba(200,210,206,.85)}
.refs li{margin-bottom:.5rem}
.refs a{word-break:break-all}

.pie{border-top:1px solid rgba(255,255,255,.1);margin-top:3rem;padding:2.4rem 5vw;text-align:center;color:rgba(200,210,206,.65);font-size:.82rem;line-height:1.7}
.pie a{color:rgba(216,169,58,.85);word-break:break-all}
